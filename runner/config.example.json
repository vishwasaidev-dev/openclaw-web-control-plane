{
  "default_model_id": "gemma-local",
  "model_search_paths": [
    "/workspace/models",
    "/runpod-volume/models",
    "/models"
  ],
  "models": [
    {
      "id": "gemma-local",
      "name": "Gemma local",
      "provider": "local",
      "path": "/workspace/models/gemma"
